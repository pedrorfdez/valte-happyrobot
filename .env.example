# HappyRobot
# API key for https://platform.eu.happyrobot.ai/api/v2 (bearer auth).
HAPPYROBOT_KEY=your_api_key_here

# Supabase
# Project settings > Data API: project URL (https://<project-ref>.supabase.co).
SUPABASE_URL=https://your-project-ref.supabase.co
# Project settings > API keys: publishable (anon) key. Safe for the dashboard.
SUPABASE_ANON_KEY=your_anon_key_here
# Project settings > API keys: secret (service_role) key. Server-side only
# (World API, simulator). Bypasses row level security. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Project settings > Database > Connection string (URI). Used for migrations
# and direct SQL. Prefer the session pooler string (port 5432).
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Channels (simulator --emit live). Perception channels point at HappyRobot
# ingest workflow webhooks; the sensor channel points at the kernel directly.
# Use webhook.site URLs until the workflows and the kernel exist.
HR_WEBHOOK_CALLS=https://workflows.platform.eu.happyrobot.ai/hooks/xlb4e31c4bw5
HR_WEBHOOK_SOCIAL=https://workflows.platform.eu.happyrobot.ai/hooks/04bq57ewbniy
HR_WEBHOOK_NEWS=https://workflows.platform.eu.happyrobot.ai/hooks/b8xaepgupozn
KERNEL_SIGNALS_URL=
# Static bearer token for kernel agent-facing and ingress routes.
WORLD_API_TOKEN=
