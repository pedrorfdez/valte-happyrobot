{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valte.dev/happyrobot/crisis-review/input.schema.json",
  "type": "object",
  "required": ["run_id", "snapshot"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "snapshot": {
      "type": "object",
      "required": ["run", "actions", "outcomes"],
      "properties": {
        "run": {
          "type": "object",
          "required": ["run_id", "status", "pack_id"],
          "properties": {
            "run_id": { "type": "string" },
            "status": { "enum": ["completed", "aborted"] },
            "pack_id": { "type": "string" }
          },
          "additionalProperties": true
        },
        "actions": { "type": "array", "items": { "type": "object" } },
        "outcomes": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
